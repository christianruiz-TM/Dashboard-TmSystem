# ============================================================
# Dashboard TmSystem — Variables de entorno
# Copiar a .env y rellenar. NUNCA commitear el .env real.
#
# PRODUCCIÓN (Docker, docs/despliegue-linux.md): el docker-compose.yml fuerza
# NODE_ENV, TZ, RDB_MOCK=0, SQLITE_PATH y TRUST_PROXY=1, así que aquí solo
# cuentan la conexión a RDBv2, SESSION_HORAS, SESSION_MAX_HORAS, el correo (SMTP_*) y COOKIE_SECURE (0 mientras sea
# HTTP). Dejar el fichero con permisos 600.
# ============================================================

# --- Conexión a RDBv2 (SQL Server, SOLO LECTURA) ---
RDB_HOST=servidor-sql.tmsystem.local
RDB_PORT=1433
RDB_DATABASE=RDBv2
RDB_USER=dashboard_ro
RDB_PASSWORD=

# Cifrado de la conexión TDS. En LAN con SQL Server sin certificado: encrypt=false.
# Si el servidor tiene certificado válido, poner RDB_ENCRYPT=true.
RDB_ENCRYPT=false
RDB_TRUST_CERT=true

# --- Modo demo (sin conexión a RDBv2) ---
# Con RDB_MOCK=1 todas las queries devuelven datos ficticios realistas.
# Útil para desarrollo de UI y para que otros modelos trabajen sin credenciales.
RDB_MOCK=1

# --- Base de datos propia de la app (SQLite) ---
SQLITE_PATH=./data/dashboard.db

# --- Sesiones ---
# Horas de validez de la sesión (expiración deslizante)
SESSION_HORAS=8
# Tope absoluto desde que se entra, aunque haya una pestaña abierta refrescándose
SESSION_MAX_HORAS=12
# Poner a 1 cuando la app esté detrás de HTTPS (fase internet) para cookies Secure
COOKIE_SECURE=0

# --- Proxy inverso ---
# Poner a 1 SOLO cuando la app esté detrás de un proxy que reescriba las
# cabeceras x-forwarded-for / x-real-ip y no se pueda llegar a ella por otro
# camino (el nginx del docker-compose.yml; allí ya va forzado a 1). Habilita la
# IP de auditoría y el rate-limit de login por usuario+IP. Con 0 se ignoran.
TRUST_PROXY=0

# --- Correo (tickets de las alertas, 12/11/2026) ---
# Servidor SMTP con el que el dashboard envía el aviso «callback sin funcionar»
# a la herramienta de tickets (el destinatario se elige en Administración →
# Callback; por defecto dtecnico@tmsystem.es). Sin SMTP_HOST no se envía nada.
# Los mismos nombres que la herramienta de tickets (/opt/tmsystem/app/.env).
# SMTP_SECURE=true con el puerto 465 (TLS directo); con 587, false (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente; vacío = SMTP_USER. NUNCA el de la herramienta de tickets
# (soporte@tmsystem.es): lo ignora para no hacer bucle. En producción:
# "Dashboard TmSystem <dtecnico@tmsystem.es>"
SMTP_FROM=
# Dirección del panel para el enlace del correo (vacío = sin enlace)
URL_PANEL=http://192.168.151.38:8081
